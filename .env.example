# ============================================================
#  UPS Expéditions — configuration
#  Copier ce fichier en ".env" puis remplir les valeurs.
# ============================================================

PORT=3000
# Mot de passe de l'interface (obligatoire en ligne, facultatif en local)
APP_PASSWORD=
# true = mode démo (fausses commandes, faux tarifs, aucune étiquette réelle)
MOCK=false

# ---------- UPS (developer.ups.com → Apps) ----------
# production = vraies étiquettes facturées ; test = environnement CIE (étiquettes factices)
UPS_ENV=test
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# Utiliser vos tarifs négociés (le compte doit être autorisé pour les tarifs négociés)
UPS_NEGOTIATED_RATES=true
# Droits et taxes à l'international payés par l'expéditeur (DDP). false = payés par le destinataire
UPS_DDP=false
# Format des étiquettes : GIF (imprimante classique / A4) ou ZPL (imprimante thermique Zebra)
UPS_LABEL_FORMAT=GIF
UPS_RATING_VERSION=v2403
UPS_SHIP_VERSION=v2409

# ---------- Expéditeur (vérifiez ces valeurs) ----------
SHIPPER_NAME=Benoît Fretel
SHIPPER_COMPANY=
SHIPPER_PHONE=
SHIPPER_EMAIL=
SHIPPER_ADDRESS1=5 Boulevard Dautry
SHIPPER_ADDRESS2=
SHIPPER_CITY=Pierrelatte
SHIPPER_POSTAL_CODE=26700
SHIPPER_COUNTRY=FR

# ---------- Douane (envois hors UE) ----------
ORIGIN_COUNTRY=FR

# ---------- eBay (developer.ebay.com → Application Keys, Production) ----------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (nom de la redirect URL, affiché dans "User Tokens")
EBAY_RUNAME=

# ---------- Etsy (etsy.com/developers/your-apps) ----------
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Version en ligne : laisser vide (callback = https://<adresse>/auth/etsy/callback).
# Version locale : Etsy exige du https:// → mettre une "Callback URL" déclarée dans l'app
# (copie exacte) et coller l'adresse d'arrivée dans l'interface.
ETSY_REDIRECT_URI=

# ---------- Shopify ----------
# Domaine de la boutique, ex. ma-boutique.myshopify.com
SHOPIFY_SHOP=
# Option A (app créée dans le Dev Dashboard) : client ID + secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B (ancienne app personnalisée créée avant 2026) : jeton admin shpat_...
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
# client_credentials (défaut) ou oauth (bouton « Connecter », version en ligne)
SHOPIFY_AUTH_MODE=client_credentials
